{
  "name": "@wrenautomation/vireo",
  "version": "0.1.2",
  "description": "The variant loop: an agent makes a batch, a person marks it, the agent learns their taste, and real numbers per segment sit beside it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrenautomation/vireo.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "drizzle",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vireo": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "default": "./dist/stats.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod 755 dist/bin.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "vireo": "tsx src/bin.ts",
    "gates": "lockf -s /tmp/wren_automation-checks.lock sh -c 'pnpm lint && pnpm typecheck && pnpm test'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@electric-sql/pglite": "^0.5.15",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@9.15.0"
}
